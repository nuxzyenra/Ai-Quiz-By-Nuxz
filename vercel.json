{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ],
  "functions": {
    "api/generate-quiz.js": {
      "maxDuration": 60
    },
    "api/evaluate-answer.js": {
      "maxDuration": 60
    }
  }
}
